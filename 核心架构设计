// 智能学习核心结构
struct smart_tombstone_learner {
    struct rb_root usage_patterns;      // 使用模式红黑树
    struct list_head app_categories;    // 应用分类列表
    ktime_t last_learning_time;         // 最后学习时间
    atomic_t learning_enabled;          // 学习开关
};

// 应用使用模式
struct app_usage_pattern {
    char package_name[128];
    int launch_count;
    ktime_t last_used_time;
    int avg_session_duration;           // 平均使用时长
    int preferred_hours[24];            // 24小时使用偏好
    enum app_behavior_type behavior;    // 行为类型
    int battery_impact;                 // 电池影响评分
    struct list_head pattern_node;
};
