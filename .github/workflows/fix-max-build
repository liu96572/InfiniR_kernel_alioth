name: Build Kernel - Fix-max Generation

on:
  workflow_dispatch:

env:
  KERNEL_NAME: InfiniR_Fixed_Image
  DEVICE: alioth

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        ref: 16.0-alioth

    - name: Install tools
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential libssl-dev bc flex bison libelf-dev gcc-aarch64-linux-gnu device-tree-compiler

    - name: Fix KernelSU
      run: |
        sed -i 's/^source "drivers\/kernelsu\/Kconfig"/# source "drivers\/kernelsu\/Kconfig"/' drivers/Kconfig 2>/dev/null || true

    - name: Build complete image
      run: |
        export ARCH=arm64
        export CROSS_COMPILE=aarch64-linux-gnu-
        export KCFLAGS="-Wno-error"
        
        echo "修复镜像生成..."
        mkdir -p out
        
        # 使用配置
        cp arch/arm64/configs/alioth_defconfig out/.config
        make O=out ARCH=arm64 olddefconfig > /dev/null 2>&1
        
        echo "步骤1: 编译vmlinux..."
        make O=out ARCH=arm64 vmlinux -j2
        
        echo "步骤2: 编译设备树..."
        make O=out ARCH=arm64 dtbs -j2 || echo "设备树编译有警告，继续..."
        
        echo "步骤3: 生成Image..."
        make O=out ARCH=arm64 Image -j2
        
        echo "步骤4: 生成压缩镜像..."
        make O=out ARCH=arm64 Image.gz -j2
        
        echo "步骤5: 生成最终镜像..."
        make O=out ARCH=arm64 Image.gz-dtb -j2
        
        echo "检查所有生成的文件:"
        echo "=== 内核文件 ==="
        find out/arch/arm64/boot/ -name "Image*" -type f 2>/dev/null
        echo "=== 设备树 ==="
        find out/ -name "*.dtb" -type f 2>/dev/null | head -5
        echo "=== 核心文件 ==="
        [ -f "out/vmlinux" ] && echo "✅ vmlinux存在" || echo "❌ vmlinux缺失"

    - name: Create package
      if: success()
      run: |
        echo "创建刷机包..."
        mkdir -p ak3_package
        
        # 尝试多种镜像格式
        if [ -f "out/arch/arm64/boot/Image.gz-dtb" ]; then
          cp out/arch/arm64/boot/Image.gz-dtb ak3_package/
          echo "✅ 使用Image.gz-dtb"
        elif [ -f "out/arch/arm64/boot/Image.gz" ]; then
          cp out/arch/arm64/boot/Image.gz ak3_package/
          echo "✅ 使用Image.gz"
        elif [ -f "out/arch/arm64/boot/Image" ]; then
          cp out/arch/arm64/boot/Image ak3_package/
          echo "✅ 使用Image"
        else
          echo "❌ 找不到任何内核镜像"
          exit 1
        fi
        
        cat > ak3_package/anykernel.sh << 'EOF'
        #!/system/bin/sh
        echo "Flashing Fixed Image Kernel"
        dd if=/tmp/anykernel/Image.gz-dtb of=/dev/block/bootdevice/by-name/boot
        echo "Flash complete!"
        EOF
        
        cd ak3_package
        zip -r9 "../${KERNEL_NAME}.zip" .
        cd ..
        
        echo "✅ 刷机包完成"
        ls -lh *.zip

    - name: Upload kernel
      if: success()
      uses: actions/upload-artifact@v4
      with:
        name: fixed-image-kernel
        path: "*.zip"
